generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  BUYER
  ORGANIZER
  ADMIN
  STAFF
}

enum OrganizerStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EventStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ON_SALE
  PAUSED
  ENDED
  FROZEN
  REJECTED
}

enum TicketStatus {
  VALID
  LISTED
  CHECKED_IN
  FROZEN
}

enum ListingStatus {
  ACTIVE
  LOCKED       // reserved: a buyer checkout is in progress (mirrors on-chain lock)
  CANCELLING   // calldata returned to seller; waiting for on-chain ListingCancelled event
  SOLD
  CANCELLED
  EXPIRED
}

enum PaymentMethod {
  PIX
  CARD
  USDC
}

enum PurchaseStatus {
  PENDING
  PAID
  MINTING
  COMPLETED
  REFUNDING
  REFUNDED
  FAILED
}

enum WithdrawalStatus {
  REQUESTED
  PROCESSING
  PAID
  FAILED
}

enum EventCategory {
  SHOW
  FESTIVAL
  TEATRO
  ESPORTE
  CONFERENCIA
  OUTRO
}

// LAYOUT_UPDATE.md §5.6.1 — escada de identificação. NONE→IDENTIFIED exigido na
// 1a compra; IDENTIFIED→VERIFIED (KYC completo) exigido no 1o anúncio de revenda.
enum KycLevel {
  NONE
  IDENTIFIED
  VERIFIED
}

// LAYOUT_UPDATE.md §5.7 — dois fluxos de recebimento, escolhidos pelo destinatário.
enum PayoutMethod {
  PIX
  CRYPTO
}

// LAYOUT_UPDATE.md §7.1 — ledger de crédito/débito. Saldo é sempre SUM(amountBrl),
// nunca um campo denormalizado escrito por fora.
enum LedgerEntryType {
  RESALE_PAYOUT
  ROYALTY_PAYOUT
  WITHDRAWAL
  WITHDRAWAL_REVERSAL
  ADJUSTMENT
}

// LAYOUT_UPDATE.md §6 — negociação P2P sobre um Listing de revenda. Nunca sobre
// venda primária.
enum NegotiationParty {
  BUYER
  SELLER
}

enum NegotiationStatus {
  OPEN
  ACCEPTED
  DECLINED
  EXPIRED
  SUPERSEDED
}

model User {
  id             String     @id @default(cuid())
  privyId        String     @unique @map("privy_id")
  email          String?    @unique
  walletAddress  String?    @unique @map("wallet_address")
  role           UserRole   @default(BUYER)
  createdAt      DateTime   @default(now()) @map("created_at")

  // Identidade — LAYOUT_UPDATE.md §5.6.1 e §5.8
  cpf            String?    @unique
  displayName    String?    @map("display_name")   // controlado: não pode imitar identidade verificada de terceiro
  kycLevel       KycLevel   @default(NONE) @map("kyc_level")
  kycVerifiedAt  DateTime?  @map("kyc_verified_at")
  verified       Boolean    @default(false)         // selo público "Verified" — identidade confirmada, não endosso

  // Recebimento — LAYOUT_UPDATE.md §5.7.1. payoutWallet NÃO existe (§5.7.3):
  // no fluxo CRYPTO o destino é sempre walletAddress, a carteira que anunciou.
  payoutMethod   PayoutMethod @default(PIX) @map("payout_method")
  pixKey         String?      @map("pix_key")
  pixKeyUpdatedAt DateTime?   @map("pix_key_updated_at")

  organizer     Organizer?
  purchases     Purchase[]
  // PLANO_EVOLUCAO_V2.md D18 — compras onde este usuário é quem recebe o
  // ingresso, não quem pagou. Relação nomeada porque Purchase já tem uma
  // relação padrão para User via `userId` (quem paga).
  purchasesReceived Purchase[] @relation("PurchaseRecipient")
  withdrawals   Withdrawal[]
  checkins      Checkin[]
  accessEntries AccessEntry[]
  ledgerEntries LedgerEntry[]
  negotiations  Negotiation[]

  @@map("users")
}

model Organizer {
  id            String          @id @default(cuid())
  userId        String          @unique @map("user_id")
  companyName   String          @map("company_name")
  document      String          // CNPJ
  payoutWallet  String          @map("payout_wallet")
  status        OrganizerStatus @default(PENDING)
  kybVerifiedAt DateTime?       @map("kyb_verified_at")  // LAYOUT_UPDATE.md §5.6.1 — exigido antes do 1o evento
  createdAt     DateTime        @default(now()) @map("created_at")

  user        User         @relation(fields: [userId], references: [id])
  events      Event[]
  collections Collection[]

  @@map("organizers")
}

// Álbum de figurinhas — PLANO_EVOLUCAO_V2.md §6.2/D15. Collection é a série
// (ex.: "Show Retrô — Edições"), definida manualmente pelo organizador; cada
// Slot é uma edição/ano da série, ligado a um Event já existente. Slot
// preenchido = usuário tem/teve ingresso pro Event daquele slot; vazio =
// não foi, e é isso que gera o gancho de demanda de revenda ("cadê minha
// figurinha de 2024?").
model Collection {
  id            String   @id @default(cuid())
  organizerId   String   @map("organizer_id")
  title         String
  description   String?
  coverImageUrl String?  @map("cover_image_url")
  createdAt     DateTime @default(now()) @map("created_at")

  organizer Organizer @relation(fields: [organizerId], references: [id])
  slots     Slot[]

  @@map("collections")
}

model Slot {
  id           String  @id @default(cuid())
  collectionId String  @map("collection_id")
  eventId      String  @unique @map("event_id") // um Event pertence a no máximo uma Collection
  label        String? // "Edição 2025"; null = usa Event.title

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  event      Event      @relation(fields: [eventId], references: [id])

  @@map("slots")
}

model Event {
  id                   String      @id @default(cuid())
  organizerId          String      @map("organizer_id")
  title                String
  description          String?
  venue                String
  city                 String
  country              String      @default("BR") // ISO 3166-1 alpha-2. Base pra hierarquia da cota de meia (lib/socialHalfQuota.ts).
  state                String?     @map("state") // UF, só quando country = "BR". Sem UF = usa a cota do país.
  latitude             Float?      // geocodificado via Nominatim (OSM) a partir de venue+city na criação/edição do evento
  longitude            Float?
  coverImageUrl        String?     @map("cover_image_url")
  coverVideoUrl        String?     @map("cover_video_url") // usado só no carrossel de destaque (LAYOUT_UPDATE.md §4.1); nunca no grid de cards
  eventDate            DateTime    @map("event_date")
  // Fim do evento — PLANO_EVOLUCAO_V2.md §10.1/D35. Obrigatório; backfill dos
  // eventos existentes copia eventDate (nenhum ingresso muda de aba na
  // migração). "Já aconteceu" (corte ingresso↔colecionável) passa a ser
  // endDate < now(), não eventDate < now() — um evento de vários dias não
  // pode virar colecionável na primeira noite.
  endDate              DateTime    @map("end_date")
  ticketPriceUsdc      Decimal     @map("ticket_price_usdc") @db.Decimal(18, 6)
  maxTickets           Int?        @map("max_tickets")
  platformFeeBps       Int         @default(800) @map("platform_fee_bps")
  royaltyBps           Int         @default(1000) @map("royalty_bps")
  royaltyOrgShareBps   Int         @default(8000) @map("royalty_org_share_bps")
  status               EventStatus @default(DRAFT)
  onchainEventId       Int?        @map("onchain_event_id")
  royaltySplitterAddr  String?     @map("royalty_splitter_address")
  createTxHash         String?     @map("create_tx_hash")
  createdAt            DateTime    @default(now()) @map("created_at")

  // Dados de evento — LAYOUT_UPDATE.md §3.1
  category      EventCategory @default(OUTRO)
  subcategory   String?
  lineup        String?
  doorsOpenAt   DateTime?     @map("doors_open_at")
  featuredRank  Int?          @map("featured_rank")   // pin do admin; null = concorre pelo ranking automático

  // Teto de revenda — LAYOUT_UPDATE.md §5.5. null = sem teto (mercado livre).
  // Basis points sobre Ticket.facePrice, nunca sobre o preço atual do evento.
  maxResaleBps  Int?          @map("max_resale_bps")

  // Reserva do organizador — PLANO_EVOLUCAO_V2.md §5.4/D19. reservedTickets é
  // a alocação total (não muda sozinha); reservedTicketsAssigned é quanto já
  // foi nomeado a um beneficiário. A diferença entre os dois é retirada da
  // disponibilidade pública (ver lib/availability.ts) — só faz sentido
  // quando maxTickets está definido; em evento sem teto não há o que reduzir.
  reservedTickets         Int @default(0) @map("reserved_tickets")
  reservedTicketsAssigned Int @default(0) @map("reserved_tickets_assigned")

  // Meia-entrada — PLANO_EVOLUCAO_V2.md §5.5/D24-D25, §10.3/D38. hasSocialHalf
  // é o opt-in do organizador — mas em categoria coberta pela Lei 12.933/2013
  // (lib/socialHalfQuota.ts:isSocialHalfMandatory) o servidor força true,
  // ignorando o body. A cota legal em si (UF→país→default) segue calculada em
  // runtime, nunca gravada — mudança de lei estadual não deve exigir migração.
  hasSocialHalf Boolean @default(false) @map("has_social_half")
  // Percentual escolhido pelo organizador — null = usa a cota legal calculada
  // em runtime (comportamento de todo evento criado antes desta fatia). Só
  // passa a ter valor quando o organizador usa o slider/checkbox pra oferecer
  // mais que o mínimo legal. Em categoria coberta, o servidor recusa < 4000.
  socialHalfBps Int? @map("social_half_bps")

  organizer   Organizer    @relation(fields: [organizerId], references: [id])
  tickets     Ticket[]
  purchases   Purchase[]
  slot        Slot?
  accessCodes  AccessCode[]
  accessEntries AccessEntry[]

  @@map("events")
}

// Código de entrada avulso — PLANO_EVOLUCAO_V2.md §10.5/D41, §10.6/D43. Dá só
// entrada, sem NFT/colecionável — não compete com a reserva (que dá os dois).
// `code` é segredo aleatório ao portador (Crockford Base32, 10 chars), único
// GLOBALMENTE (não por evento) porque POST /api/checkin não recebe eventId —
// deriva do que foi escaneado/digitado. Guardado em plaintext de propósito: o
// organizador precisa re-listar "qual código mandei pra quem" (label), e o
// dano de vazamento é limitado (entrada única, revogável, vaga já contada).
model AccessCode {
  id        String    @id @default(cuid())
  eventId   String    @map("event_id")
  code      String    @unique
  label     String?
  createdBy String    @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at")
  usedAt    DateTime? @map("used_at")
  revokedAt DateTime? @map("revoked_at")

  event Event        @relation(fields: [eventId], references: [id])
  entry AccessEntry?

  @@index([eventId])
  @@map("access_codes")
}

// Entrada via AccessCode — tabela PRÓPRIA, não Checkin. Checkin.tokenId exige
// Ticket (FK obrigatória); entrada por código não tem ingresso. Fundir os
// dois quebraria computeAchievements (lib/achievements.ts, percorre
// checkin.ticket.event.city) e faria o produto contar presença de quem não
// tem colecionável como conquista — que é exatamente o que não deve.
model AccessEntry {
  id           String   @id @default(cuid())
  accessCodeId String   @unique @map("access_code_id")
  eventId      String   @map("event_id")
  staffUserId  String   @map("staff_user_id")
  scannedAt    DateTime @default(now()) @map("scanned_at")

  accessCode AccessCode @relation(fields: [accessCodeId], references: [id])
  event      Event      @relation(fields: [eventId], references: [id])
  staff      User       @relation(fields: [staffUserId], references: [id])

  @@index([eventId])
  @@map("access_entries")
}

model Ticket {
  tokenId      Int          @id @map("token_id")
  eventId      String       @map("event_id")
  ownerAddress String       @map("owner_address")
  ticketNumber Int          @map("ticket_number")
  seat         String?
  facePrice    Decimal      @map("face_price") @db.Decimal(18, 6)
  status       TicketStatus @default(VALID)
  mintTxHash   String?      @map("mint_tx_hash")
  mintedAt     DateTime?    @map("minted_at")

  // Meia-entrada — PLANO_EVOLUCAO_V2.md D25. Nominal, exige comprovante na
  // portaria; por isso nunca entra na revenda (checado em POST /api/listings).
  isHalfPrice  Boolean      @default(false) @map("is_half_price")

  event    Event     @relation(fields: [eventId], references: [id])
  listing  Listing?
  purchase Purchase?
  checkin  Checkin?

  @@unique([eventId, ticketNumber])
  @@map("tickets")
}

model Listing {
  id               String        @id @default(cuid())
  onchainListingId Int?          @unique @map("onchain_listing_id")
  tokenId          Int           @unique @map("token_id")
  sellerAddress    String        @map("seller_address")
  price            Decimal       @db.Decimal(18, 6)
  paymentToken     String        @map("payment_token")
  expiresAt        DateTime?     @map("expires_at")
  status           ListingStatus @default(ACTIVE)
  txHash           String?       @map("tx_hash")
  createdAt        DateTime      @default(now()) @map("created_at")

  ticket        Ticket         @relation(fields: [tokenId], references: [tokenId])
  purchases     Purchase[]
  negotiations  Negotiation[]

  @@map("listings")
}

model Purchase {
  id            String         @id @default(cuid())
  userId        String         @map("user_id")
  eventId       String         @map("event_id")
  listingId     String?        @map("listing_id")
  tokenId       Int?           @unique @map("token_id")
  amountBrl     Decimal        @map("amount_brl") @db.Decimal(10, 2)
  amountUsdc    Decimal        @map("amount_usdc") @db.Decimal(18, 6)
  fxRate        Decimal        @map("fx_rate") @db.Decimal(10, 6)
  pspProvider   String?        @map("psp_provider")
  pspChargeId   String         @unique @map("psp_charge_id")
  paymentMethod PaymentMethod  @map("payment_method")
  status        PurchaseStatus @default(PENDING)
  mintTxHash    String?        @map("mint_tx_hash")
  createdAt     DateTime       @default(now()) @map("created_at")
  paidAt        DateTime?      @map("paid_at")
  completedAt   DateTime?      @map("completed_at")

  // Presente — PLANO_EVOLUCAO_V2.md D18. Null = comprou pra si mesmo (o caso
  // comum); resolução em runtime cai pra userId quando null, então nenhuma
  // query antiga precisa mudar. Nunca aponta pra alguém sem walletAddress —
  // isso é validado no checkout, não aqui.
  recipientUserId String? @map("recipient_user_id")

  // Reserva do organizador — PLANO_EVOLUCAO_V2.md D19. true = esta compra
  // consumiu uma unidade de Event.reservedTickets (paga só a taxa da
  // plataforma) em vez de vir da oferta pública.
  isReservedAllocation Boolean @default(false) @map("is_reserved_allocation")

  // Meia-entrada — PLANO_EVOLUCAO_V2.md D24. true = comprador declarou
  // meia-entrada no checkout; amountUsdc já sai pela metade do preço do
  // evento. Copiado pro Ticket.isHalfPrice no mint (webhooks/psp/route.ts).
  isHalfPrice Boolean @default(false) @map("is_half_price")

  user      User     @relation(fields: [userId], references: [id])
  recipient User?    @relation("PurchaseRecipient", fields: [recipientUserId], references: [id])
  event     Event    @relation(fields: [eventId], references: [id])
  listing   Listing? @relation(fields: [listingId], references: [id])
  ticket    Ticket?  @relation(fields: [tokenId], references: [tokenId])
  ledgerEntries LedgerEntry[]

  @@map("purchases")
}

model Withdrawal {
  id                 String           @id @default(cuid())
  userId             String           @map("user_id")
  amount             Decimal          @map("amount") @db.Decimal(18, 6) // off-ramped asset amount (USDC today, not necessarily forever)
  amountBrl          Decimal          @map("amount_brl") @db.Decimal(10, 2)
  fxRate             Decimal          @map("fx_rate") @db.Decimal(10, 6)
  pixKey             String           @map("pix_key")
  status             WithdrawalStatus @default(REQUESTED)
  usdcTransferTxHash String?          @map("usdc_transfer_tx_hash")
  createdAt          DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])
  ledgerEntries LedgerEntry[]

  @@map("withdrawals")
}

model Checkin {
  id          String   @id @default(cuid())
  tokenId     Int      @unique @map("token_id")
  eventId     String   @map("event_id")
  staffUserId String   @map("staff_user_id")
  scannedAt   DateTime @default(now()) @map("scanned_at")

  ticket Ticket @relation(fields: [tokenId], references: [tokenId])
  staff  User   @relation(fields: [staffUserId], references: [id])

  @@map("checkins")
}

model SyncState {
  contractAddress    String @id @map("contract_address")
  lastProcessedBlock BigInt @map("last_processed_block")

  @@map("sync_state")
}

// LAYOUT_UPDATE.md §7 — saldo é sempre SUM(amountBrl) por usuário, nunca lido de
// um campo denormalizado. onchainTxHash aponta para a tx de settle que gravou o
// atestado do split (§5.7.2) — é o que a UI usa para marcar "conferido on-chain".
model LedgerEntry {
  id            String          @id @default(cuid())
  userId        String          @map("user_id")
  type          LedgerEntryType
  amountBrl     Decimal         @map("amount_brl") @db.Decimal(10, 2)
  description   String
  purchaseId    String?         @map("purchase_id")
  withdrawalId  String?         @map("withdrawal_id")
  onchainTxHash String?         @map("onchain_tx_hash")
  createdAt     DateTime        @default(now()) @map("created_at")

  user       User        @relation(fields: [userId], references: [id])
  purchase   Purchase?   @relation(fields: [purchaseId], references: [id])
  withdrawal Withdrawal? @relation(fields: [withdrawalId], references: [id])

  @@index([userId, createdAt])
  @@map("ledger_entries")
}

// LAYOUT_UPDATE.md §6 — negociação assíncrona sobre um Listing de revenda.
// Um comprador só pode ter uma thread aberta por anúncio; várias threads
// concorrentes (compradores distintos) são permitidas — a primeira que fecha
// leva, as demais viram SUPERSEDED na mesma transação (§6.3).
model Negotiation {
  id          String            @id @default(cuid())
  listingId   String            @map("listing_id")
  buyerUserId String            @map("buyer_user_id")
  status      NegotiationStatus @default(OPEN)
  turn        NegotiationParty
  roundCount  Int               @default(1) @map("round_count")
  expiresAt   DateTime          @map("expires_at")
  agreedPrice Decimal?          @map("agreed_price") @db.Decimal(18, 6)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  listing Listing            @relation(fields: [listingId], references: [id])
  buyer   User               @relation(fields: [buyerUserId], references: [id])
  rounds  NegotiationRound[]

  @@unique([listingId, buyerUserId])
  @@index([listingId, status])
  @@map("negotiations")
}

model NegotiationRound {
  id            String           @id @default(cuid())
  negotiationId String           @map("negotiation_id")
  roundNumber   Int              @map("round_number")
  author        NegotiationParty
  priceUsdc     Decimal          @map("price_usdc") @db.Decimal(18, 6)
  createdAt     DateTime         @default(now()) @map("created_at")

  negotiation Negotiation @relation(fields: [negotiationId], references: [id])

  @@map("negotiation_rounds")
}
